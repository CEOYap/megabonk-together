<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MegabonkTogether</AssemblyName>
    <Product>MegabonkTogether</Product>
    <Version>5.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      <!--https://nuget.samboy.dev/v3/index.json-->  <!--this one is down -->
    </RestoreAdditionalProjectSources>
    <RootNamespace>MegabonkTogether</RootNamespace>
  </PropertyGroup>

  <!-- Define THUNDERSTORE when THUNDERSTORE_BUILD environment variable is set (For GitHub Actions) -->
  <PropertyGroup Condition=" '$(THUNDERSTORE_BUILD)' == 'true' ">
    <DefineConstants>$(DefineConstants);THUNDERSTORE</DefineConstants>
  </PropertyGroup>

  <!-- Define PROTON when PROTON_BUILD environment variable is set (For Linux/Proton builds) -->
  <PropertyGroup Condition=" '$(PROTON_BUILD)' == 'true' ">
    <DefineConstants>$(DefineConstants);PROTON</DefineConstants>
  </PropertyGroup>

	<PropertyGroup>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<!--
		The UI AssetBundle, authored in unity-ui/ and built by MegabonkTogether/Build UI Bundle.
		Conditional so the plugin still builds before the bundle has been generated: UiAssetService
		reports the missing resource and the UI falls back rather than failing the build.
	-->
	<ItemGroup>
		<EmbeddedResource Include="Resources/megabonktogether.ui"
		                  LogicalName="MegabonkTogether.Resources.megabonktogether.ui"
		                  Condition="Exists('$(MSBuildProjectDirectory)/Resources/megabonktogether.ui')" />
	</ItemGroup>

	<ItemGroup>
		<None Include="CHANGELOG.toml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
	<PackageReference Include="Microsoft.Extensions.Hosting" Version="6.0.1" />
	<PackageReference Include="Profanity.Detector" Version="0.1.8" />
	<PackageReference Include="TextCopy" Version="6.2.1" />
	<PackageReference Include="Tomlyn" Version="0.17.0" />
	</ItemGroup>

	<!-- Set default paths -->
	<PropertyGroup>
		<AssemblyPath>$(MSBuildProjectDirectory)/stripped-libs/interop</AssemblyPath>
		<UnityLibPath>$(MSBuildProjectDirectory)/stripped-libs/unity-libs</UnityLibPath>
	</PropertyGroup>

	<!-- Use MegabonkPath if BepInEx exists there -->
	<PropertyGroup Condition="'$(MegabonkPath)' != '' And Exists('$(MegabonkPath)/BepInEx/interop')">
		<AssemblyPath>$(MegabonkPath)/BepInEx/interop</AssemblyPath>
		<UnityLibPath>$(MegabonkPath)/BepInEx/unity-libs</UnityLibPath>
		<PluginPath>$(MegabonkPath)/BepInEx/plugins</PluginPath>
	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\common\MegabonkTogether.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(AssemblyPath)/Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(UnityLibPath)/UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.AnimationModule">
			<HintPath>$(UnityLibPath)/UnityEngine.AnimationModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.PhysicsModule">
			<HintPath>$(UnityLibPath)/UnityEngine.PhysicsModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.ParticleSystem">
			<HintPath>$(UnityLibPath)/UnityEngine.ParticleSystemModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.AudioModule">
			<HintPath>$(UnityLibPath)/UnityEngine.AudioModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<!--
			interop, not unity-libs. unity-libs holds stock Unity assemblies whose array-taking
			signatures are byte[]/T[]; the interop proxies that actually load at runtime take
			Il2CppStructArray<T>. Compiling AssetBundle.LoadFromMemory against unity-libs bound to
			an overload that does not exist in the game and threw MissingMethodException at the
			first call. Any module whose API passes arrays belongs here.
		-->
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(AssemblyPath)/UnityEngine.UIModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.AssetBundleModule">
			<HintPath>$(AssemblyPath)/UnityEngine.AssetBundleModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(AssemblyPath)/UnityEngine.UI.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(AssemblyPath)/Unity.TextMeshPro.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Il2Cpp.Mscorlib">
			<HintPath>$(AssemblyPath)/Il2Cppmscorlib.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Il2CppSystem.dll">
			<HintPath>$(AssemblyPath)/Il2CppSystem.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Il2CppSystem.Core.dll">
			<HintPath>$(AssemblyPath)/Il2CppSystem.Core.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Rewired_Core">
			<HintPath>$(AssemblyPath)/Rewired_Core.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.Localization">
			<HintPath>$(AssemblyPath)/Unity.Localization.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Coffee.UIParticle">
			<HintPath>$(AssemblyPath)/Coffee.UIParticle.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<!--
			Steamworks.NET, as the game already ships it. Not our own managed copy: the game pumps
			Steamworks.NET's CallbackDispatcher every frame over the process's single manual-dispatch
			pipe, and manual dispatch consumes each callback, so a second managed wrapper would take
			the game's own callbacks off the queue rather than merely duplicating them. Reasoning and
			evidence: docs/steamworks/00-migration-plan.md, Gotcha 1.
		-->
		<Reference Include="com.rlabrecque.steamworks.net">
			<HintPath>$(AssemblyPath)/com.rlabrecque.steamworks.net.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- Skip PostBuild copy when running in CI (GitHub Actions or other CI systems setting CI env var) -->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition=" '$(GITHUB_ACTIONS)' != 'true' And '$(CI)' != 'true' ">
		<Exec Command="xcopy /Y /I &quot;$(TargetDir)&quot; &quot;$(PluginPath)\\MegabonkTogether&quot;" Condition=" '$(PluginPath)' != '' And '$(Configuration)' == 'Debug' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' " />
		<Exec Command="mkdir -p &quot;$(PluginPath)/MegabonkTogether&quot; &amp;&amp; cp -r &quot;$(TargetDir)&quot;* &quot;$(PluginPath)/MegabonkTogether/&quot;" Condition=" '$(PluginPath)' != '' And '$(Configuration)' == 'Debug' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' " />
	</Target>
</Project>
